# GCP
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1

# GCS — single bucket, all data separated by prefix
GCS_BUCKET=skumar_trace_ai
GCS_RAW_PREFIX=raw
GCS_PROCESSING_PREFIX=processing
GCS_CURATED_PREFIX=curated
GCS_KB_PREFIX=kb

# Document AI — Form Parser handles both digital and scanned PDFs
DOCUMENT_AI_FORM_PROCESSOR_ID=your-form-parser-processor-id
DOCUMENT_AI_LOCATION=us

# Cloud DLP
# Set DLP_ENABLED=false to skip PII masking entirely (not recommended for production)
DLP_ENABLED=true
# Location for DLP API calls — "global" works for all regions; use a specific region for data residency
DLP_LOCATION=global
# Leave template names empty to use inline config (default)
# Set to full resource name to use stored GCP templates:
#   projects/<project>/locations/global/inspectTemplates/<id>
#   projects/<project>/locations/global/deidentifyTemplates/<id>
DLP_INSPECT_TEMPLATE_NAME=
DLP_DEIDENTIFY_TEMPLATE_NAME=
DLP_MASK_CHARACTER=*
# 0 = mask entire matched span
DLP_NUMBER_TO_MASK=0
# POSSIBLE_REGION | LIKELY | VERY_LIKELY
DLP_MIN_LIKELIHOOD=LIKELY

# Vertex AI
VERTEX_GEMINI_MODEL=gemini-1.5-pro
VERTEX_GEMINI_LOCATION=us-central1
VERTEX_EMBEDDING_MODEL=text-embedding-004
VERTEX_EMBEDDING_LOCATION=us-central1
VERTEX_EMBEDDING_DIMENSIONS=768
VERTEX_VECTOR_SEARCH_INDEX_ID=your-index-id
VERTEX_VECTOR_SEARCH_ENDPOINT_ID=your-endpoint-id
VERTEX_VECTOR_SEARCH_LOCATION=us-central1
VERTEX_VECTOR_SEARCH_DEPLOYED_INDEX_ID=trace-kb-deployed
VERTEX_VECTOR_SEARCH_INDEX_DISPLAY_NAME=trace-kb-index
VERTEX_VECTOR_SEARCH_ENDPOINT_DISPLAY_NAME=trace-kb-endpoint

# Vector Search algorithm: "tree_ah" or "brute_force"
VERTEX_VECTOR_SEARCH_ALGORITHM=tree_ah

# Distance measure: DOT_PRODUCT_DISTANCE | SQUARED_L2_DISTANCE | L1_DISTANCE | COSINE_DISTANCE
VERTEX_VECTOR_SEARCH_DISTANCE_MEASURE=DOT_PRODUCT_DISTANCE

# Update method: STREAM_UPDATE | BATCH_UPDATE
VERTEX_VECTOR_SEARCH_UPDATE_METHOD=STREAM_UPDATE

# Feature norm type: UNIT_L2_NORM | NONE
VERTEX_VECTOR_SEARCH_FEATURE_NORM_TYPE=UNIT_L2_NORM

# Shard size: SHARD_SIZE_SMALL | SHARD_SIZE_MEDIUM | SHARD_SIZE_LARGE
VERTEX_VECTOR_SEARCH_SHARD_SIZE=SHARD_SIZE_MEDIUM

# Tree-AH tuning (only used when VERTEX_VECTOR_SEARCH_ALGORITHM=tree_ah)
VERTEX_VECTOR_SEARCH_APPROXIMATE_NEIGHBORS_COUNT=10
VERTEX_VECTOR_SEARCH_LEAF_NODE_EMBEDDING_COUNT=1000
VERTEX_VECTOR_SEARCH_LEAF_NODES_TO_SEARCH_PERCENT=1

# Deployment sizing
VERTEX_VECTOR_SEARCH_MIN_REPLICAS=1
VERTEX_VECTOR_SEARCH_MAX_REPLICAS=2

# Storage backend: "firestore" or "bigquery"
STORAGE_BACKEND=firestore

# Firestore (used when STORAGE_BACKEND=firestore)
FIRESTORE_COLLECTION_CONTRACTS=contracts
FIRESTORE_COLLECTION_AUDIT=audit_events

# BigQuery (used when STORAGE_BACKEND=bigquery)
# Full table refs built as: GCP_PROJECT_ID.BIGQUERY_DATASET.BIGQUERY_TABLE_*
# BIGQUERY_LOCATION is independent of GCP_REGION — supports US, EU, global, or specific regions
BIGQUERY_DATASET=trace_contracts
BIGQUERY_TABLE_CONTRACTS=contracts
BIGQUERY_TABLE_AUDIT=audit_events
BIGQUERY_LOCATION=US

# Validation thresholds
CONFIDENCE_THRESHOLD_APPROVE=0.85
CONFIDENCE_THRESHOLD_REVIEW=0.60

# Duplicate detection — set to false to allow reprocessing the same contract file
DUPLICATE_CHECK_ENABLED=true

# Max upload file size in MB — default is 50
MAX_FILE_SIZE_BYTES=50

# Logging
# DEBUG | INFO | WARNING | ERROR | CRITICAL — default is INFO
LOG_LEVEL=INFO
# Set LOG_TO_FILE=true to write logs to a rotating file (useful for local debugging)
LOG_TO_FILE=false
LOG_FILE_PATH=logs/trace_ai.log
LOG_FILE_MAX_BYTES=5242880
LOG_FILE_BACKUP_COUNT=3
